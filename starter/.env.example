# Base URL of the HitBox backend serving the public web API.
# The four lead-capture endpoints live under /app/web/v1 on this host.
#
# Copy this file to .env.local and fill in the host for the environment you
# are pointing at. Real hostnames are deliberately not committed — ask the
# backend team, or read them from the Vercel project settings.
#
# Unset falls back to http://localhost:8000, matching a backend running
# locally.
#
# This is a NEXT_PUBLIC_ variable, so it is inlined into the client bundle at
# build time. Set it in the Vercel project settings for every environment, or
# a deploy will fall back to localhost and every form will fail with a
# connection error.
NEXT_PUBLIC_WEB_API_URL=https://your-backend-host.example
